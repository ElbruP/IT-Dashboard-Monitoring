# Datenbank
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=monitoring
DB_USER=monitoring
DB_PASSWORT=bitte_aendern
# DB_SOCKET=/run/mysqld/mysqld.sock

# Externe Quellen
# Ohne Token: 60 Anfragen/Stunde. Mit Token: 5000.
GITHUB_TOKEN=
HTTP_TIMEOUT=10
HTTP_VERSUCHE=3

# Zeitsteuerung (Minuten)
INTERVALL_VERSIONEN_MIN=60
INTERVALL_SCHWELLWERTE_MIN=5
INTERVALL_SIMULATION_MIN=5
SIMULATION_AKTIV=true
ZEITZONE=Europe/Berlin

# Sitzung
# Erzeugen mit: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SITZUNG_SCHLUESSEL=
SITZUNG_DAUER_MIN=480
COOKIE_SICHER=false

# E-Mail-Benachrichtigung
MAIL_AKTIV=false
SMTP_HOST=
SMTP_PORT=587
SMTP_BENUTZER=
SMTP_KENNWORT=
SMTP_STARTTLS=true
MAIL_ABSENDER=monitoring@example.de
MAIL_EMPFAENGER=it-team@example.de
INTERVALL_BENACHRICHTIGUNG_MIN=10
INTERVALL_MELDUNGEN_MIN=15
